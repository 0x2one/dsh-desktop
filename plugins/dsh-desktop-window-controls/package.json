{
  "name": "@dsh-desktop/window-controls",
  "version": "0.1.9",
  "description": "dsh-desktop window controls (minimize / maximize / close) rendered in the DeepSeek Harness web UI top-right corner",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^1.0.0",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0",
    "react": "^18.2.0"
  }
}
